{
  "name": "map-history-video",
  "version": "1.0.0",
  "private": true,
  "description": "Code-generated animated map explainer videos (Remotion + free Kokoro voice)",
  "scripts": {
    "studio": "remotion studio src/index.ts",
    "render": "remotion render src/index.ts HistoryVideo out/video.mp4",
    "check": "tsx scripts/check.ts",
    "srt": "node scripts/srt.mjs",
    "voice:local": "sh -c 'PYTHONWARNINGS=ignore .venv-tts/bin/python scripts/tts_local.py \"${0:-episode/demo.json}\"'",
    "maps": "tsx scripts/map-views.ts && .venv-tts/bin/python scripts/make_maps.py"
  },
  "dependencies": {
    "@remotion/cli": "4.0.545",
    "@remotion/renderer": "4.0.545",
    "d3-geo": "^3.1.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "remotion": "4.0.545",
    "topojson-client": "^3.1.0",
    "world-atlas": "^2.0.2"
  },
  "devDependencies": {
    "@types/d3-geo": "^3.1.1",
    "@types/react": "^18.3.0",
    "@types/topojson-client": "^3.1.5",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
